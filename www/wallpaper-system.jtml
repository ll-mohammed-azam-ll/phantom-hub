```html
<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chat Wallpaper Settings</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        gold: {
                            50: '#FFFDF0',
                            100: '#FEF9CF',
                            200: '#FDEE9F',
                            300: '#FBDE6A',
                            400: '#F9C93E',
                            500: '#D9A71E', // Signature premium Gold
                            600: '#B88611',
                            700: '#946B0D',
                            800: '#70510A',
                            900: '#4C3707',
                        },
                        darkBg: '#09090B', // Zinc-950 deep space black
                        darkPanel: 'rgba(20, 20, 22, 0.7)',
                    }
                }
            }
        }
    </script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #09090B;
            color: #F4F4F5;
            overflow-x: hidden;
        }

        /* Glassmorphism custom styling */
        .glass-panel {
            background: rgba(18, 18, 22, 0.65);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(217, 167, 30, 0.15); /* Gold outline hint */
        }

        .glass-card {
            background: rgba(30, 30, 36, 0.4);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.05);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .glass-card:hover {
            border-color: rgba(217, 167, 30, 0.4);
            transform: translateY(-2px);
            box-shadow: 0 10px 20px -10px rgba(217, 167, 30, 0.15);
        }

        .glass-btn {
            background: rgba(217, 167, 30, 0.1);
            border: 1px solid rgba(217, 167, 30, 0.3);
            backdrop-filter: blur(8px);
            transition: all 0.2s;
        }

        .glass-btn:hover {
            background: rgba(217, 167, 30, 0.25);
            border-color: rgba(217, 167, 30, 0.6);
            transform: scale(1.02);
        }

        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(9, 9, 11, 0.5);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(217, 167, 30, 0.3);
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(217, 167, 30, 0.6);
        }

        /* Smooth page transition animations */
        .view-transition {
            transition: transform 0.35s cubic-bezier(0.32, 0.94, 0.6, 1), opacity 0.35s ease;
        }

        /* Ambient glow spots */
        .ambient-glow {
            position: absolute;
            width: 350px;
            height: 350px;
            background: radial-gradient(circle, rgba(217, 167, 30, 0.15) 0%, rgba(0,0,0,0) 70%);
            pointer-events: none;
            z-index: 0;
            border-radius: 50%;
        }

        /* Image color-extraction canvas overlay element (hidden) */
        #extraction-canvas {
            display: none;
        }
    </style>
</head>
<body class="h-full w-full flex justify-center items-center p-0 md:p-4 overflow-hidden relative">

    <!-- Ambient Gold Background Glows -->
    <div class="ambient-glow -top-20 -left-20"></div>
    <div class="ambient-glow -bottom-20 -right-20"></div>

    <!-- Hidden Canvas used for extracting vibrant colors from selected images -->
    <canvas id="extraction-canvas"></canvas>

    <!-- Main Container App Frame (Simulating a premium mobile/desktop chat setting view) -->
    <div class="w-full h-full max-w-6xl md:h-[90vh] glass-panel rounded-none md:rounded-3xl shadow-2xl overflow-hidden flex flex-col md:flex-row z-10">
        
        <!-- ================== LEFT PANEL: Navigation & Options ================== -->
        <div class="w-full md:w-[60%] flex flex-col h-full border-b md:border-b-0 md:border-r border-gold-500/15 relative overflow-hidden">
            
            <!-- Header -->
            <header class="p-5 flex items-center justify-between border-b border-white/5 bg-black/40 backdrop-blur-md z-20">
                <div class="flex items-center gap-3">
                    <button id="nav-back-btn" class="p-2 rounded-lg bg-white/5 border border-white/10 hover:border-gold-500/30 transition-colors hidden" aria-label="Go back">
                        <i data-lucide="chevron-left" class="w-5 h-5 text-gold-400"></i>
                    </button>
                    <div>
                        <h1 class="text-lg font-bold tracking-wide text-transparent bg-clip-text bg-gradient-to-r from-white via-gold-100 to-gold-400">
                            Wallpaper Studio
                        </h1>
                        <p class="text-xs text-zinc-400">Chat customizer & dynamic styling</p>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <span class="text-[10px] uppercase font-semibold tracking-widest bg-gold-500/10 text-gold-400 px-2.5 py-1 rounded-full border border-gold-500/30">
                        Pro Settings
                    </span>
                </div>
            </header>

            <!-- Navigation Stack Screens Container -->
            <div class="flex-1 overflow-y-auto relative p-5 space-y-6" id="screens-container">

                <!-- SCREEN 1: WALLPAPER HOME (Main Selection Menu) -->
                <div id="screen-main" class="view-transition space-y-6">
                    <!-- Intro banner -->
                    <div class="p-5 rounded-2xl bg-gradient-to-br from-zinc-900/80 to-zinc-950/85 border border-gold-500/20 relative overflow-hidden">
                        <div class="absolute -right-10 -bottom-10 w-32 h-32 bg-gold-500/10 rounded-full blur-2xl"></div>
                        <span class="text-xs font-bold text-gold-400 uppercase tracking-widest">Aesthetic engine</span>
                        <h2 class="text-xl font-bold mt-1 text-white">Dynamic Color Sync</h2>
                        <p class="text-xs text-zinc-400 mt-2 leading-relaxed">
                            Select any modern wallpaper category. Our algorithm dynamically extracts and applies ambient accents to your chat bubbles, inputs, and overlays automatically!
                        </p>
                    </div>

                    <!-- Category Section -->
                    <div>
                        <h3 class="text-sm font-semibold text-zinc-400 uppercase tracking-wider mb-4">Choose Category</h3>
                        <div class="grid grid-cols-2 gap-3">
                            <!-- Custom Upload Card -->
                            <div onclick="navigateTo('screen-gallery')" class="glass-card p-4 rounded-2xl flex flex-col items-center justify-center text-center cursor-pointer min-h-[120px] group relative overflow-hidden">
                                <div class="absolute top-2 right-2 w-2 h-2 rounded-full bg-gold-500 animate-pulse"></div>
                                <div class="p-3 rounded-full bg-gold-500/10 text-gold-400 group-hover:bg-gold-500/20 transition-all">
                                    <i data-lucide="image-plus" class="w-6 h-6"></i>
                                </div>
                                <span class="text-sm font-semibold mt-3 text-white">Your Photo</span>
                                <span class="text-[10px] text-zinc-500">Auto Theme Sync</span>
                            </div>

                            <!-- Gradients -->
                            <div onclick="navigateTo('screen-gradients')" class="glass-card p-4 rounded-2xl flex flex-col items-center justify-center text-center cursor-pointer min-h-[120px] group">
                                <div class="p-3 rounded-full bg-zinc-800 text-zinc-300 group-hover:bg-gold-500/20 group-hover:text-gold-400 transition-all">
                                    <i data-lucide="palette" class="w-6 h-6"></i>
                                </div>
                                <span class="text-sm font-semibold mt-3 text-white">Gradients</span>
                                <span class="text-[10px] text-zinc-500">Smooth & Radiant</span>
                            </div>

                            <!-- Abstract Landscapes -->
                            <div onclick="navigateTo('screen-abstract')" class="glass-card p-4 rounded-2xl flex flex-col items-center justify-center text-center cursor-pointer min-h-[120px] group">
                                <div class="p-3 rounded-full bg-zinc-800 text-zinc-300 group-hover:bg-gold-500/20 group-hover:text-gold-400 transition-all">
                                    <i data-lucide="layers" class="w-6 h-6"></i>
                                </div>
                                <span class="text-sm font-semibold mt-3 text-white">Abstract Art</span>
                                <span class="text-[10px] text-zinc-500">Premium Digital Art</span>
                            </div>

                            <!-- Minimal Dark -->
                            <div onclick="navigateTo('screen-min-dark')" class="glass-card p-4 rounded-2xl flex flex-col items-center justify-center text-center cursor-pointer min-h-[120px] group">
                                <div class="p-3 rounded-full bg-zinc-800 text-zinc-300 group-hover:bg-gold-500/20 group-hover:text-gold-400 transition-all">
                                    <i data-lucide="moon" class="w-6 h-6"></i>
                                </div>
                                <span class="text-sm font-semibold mt-3 text-white">Minimal Dark</span>
                                <span class="text-[10px] text-zinc-500">Deep & OLED Friendly</span>
                            </div>

                            <!-- Minimal Light -->
                            <div onclick="navigateTo('screen-min-light')" class="glass-card p-4 rounded-2xl flex flex-col items-center justify-center text-center cursor-pointer min-h-[120px] group">
                                <div class="p-3 rounded-full bg-zinc-800 text-zinc-300 group-hover:bg-gold-500/20 group-hover:text-gold-400 transition-all">
                                    <i data-lucide="sun" class="w-6 h-6"></i>
                                </div>
                                <span class="text-sm font-semibold mt-3 text-white">Minimal Light</span>
                                <span class="text-[10px] text-zinc-500">Clean & Bright Aesthetic</span>
                            </div>

                            <!-- Solids -->
                            <div onclick="navigateTo('screen-solids')" class="glass-card p-4 rounded-2xl flex flex-col items-center justify-center text-center cursor-pointer min-h-[120px] group">
                                <div class="p-3 rounded-full bg-zinc-800 text-zinc-300 group-hover:bg-gold-500/20 group-hover:text-gold-400 transition-all">
                                    <i data-lucide="spray-can" class="w-6 h-6"></i>
                                </div>
                                <span class="text-sm font-semibold mt-3 text-white">Solid Colors</span>
                                <span class="text-[10px] text-zinc-500">Classic Minimalism</span>
                            </div>
                        </div>
                    </div>

                    <!-- Ambient Sound / Quick Toggles inside Chat settings -->
                    <div>
                        <h3 class="text-sm font-semibold text-zinc-400 uppercase tracking-wider mb-4">Chat Environment Toggles</h3>
                        <div class="space-y-3">
                            <div class="flex items-center justify-between p-3 rounded-xl bg-white/5 border border-white/5">
                                <div class="flex items-center gap-3">
                                    <div class="p-2 rounded-lg bg-gold-500/10 text-gold-400">
                                        <i data-lucide="sparkles" class="w-4 h-4"></i>
                                    </div>
                                    <div>
                                        <p class="text-xs font-semibold text-white">Auto Dark/Light Theme Sync</p>
                                        <p class="text-[10px] text-zinc-400">Matches system appearance seamlessly</p>
                                    </div>
                                </div>
                                <label class="relative inline-flex items-center cursor-pointer">
                                    <input type="checkbox" id="theme-sync-toggle" checked class="sr-only peer">
                                    <div class="w-9 h-5 bg-zinc-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-zinc-300 after:border-zinc-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-gold-500"></div>
                                </label>
                            </div>

                            <div class="flex items-center justify-between p-3 rounded-xl bg-white/5 border border-white/5">
                                <div class="flex items-center gap-3">
                                    <div class="p-2 rounded-lg bg-gold-500/10 text-gold-400">
                                        <i data-lucide="eye-off" class="w-4 h-4"></i>
                                    </div>
                                    <div>
                                        <p class="text-xs font-semibold text-white">Aesthetic Contrast Guard</p>
                                        <p class="text-[10px] text-zinc-400">Ensures chat bubbles always have high legibility</p>
                                    </div>
                                </div>
                                <label class="relative inline-flex items-center cursor-pointer">
                                    <input type="checkbox" id="contrast-guard-toggle" checked class="sr-only peer">
                                    <div class="w-9 h-5 bg-zinc-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-zinc-300 after:border-zinc-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-gold-500"></div>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SCREEN 2: CUSTOM GALLERY UPLOADER -->
                <div id="screen-gallery" class="view-transition hidden space-y-6">
                    <div class="flex items-center gap-2 text-gold-400 font-semibold text-sm mb-2">
                        <i data-lucide="image-plus" class="w-4 h-4"></i>
                        <span>Upload Custom Wallpaper</span>
                    </div>

                    <div class="border-2 border-dashed border-zinc-700 hover:border-gold-500/50 rounded-2xl p-8 text-center cursor-pointer transition-colors bg-zinc-900/30 flex flex-col items-center justify-center group relative" id="dropzone">
                        <input type="file" id="file-input" class="absolute inset-0 opacity-0 cursor-pointer" accept="image/*">
                        <div class="p-4 rounded-full bg-zinc-800/80 group-hover:bg-gold-500/15 group-hover:text-gold-400 transition-colors mb-4">
                            <i data-lucide="upload-cloud" class="w-8 h-8 text-zinc-400 group-hover:text-gold-400"></i>
                        </div>
                        <p class="text-sm font-semibold text-white">Drag & drop or click to choose file</p>
                        <p class="text-xs text-zinc-500 mt-2">Supports JPG, PNG, WEBP (Max 10MB)</p>
                        <p class="text-xs text-gold-400/80 mt-1">Our dynamic palette will map chat themes instantly!</p>
                    </div>

                    <!-- Custom uploads recent row -->
                    <div class="space-y-3">
                        <h4 class="text-xs font-semibold text-zinc-400 uppercase tracking-widest">Recent Uploads</h4>
                        <div class="grid grid-cols-4 gap-2" id="recent-custom-uploads">
                            <!-- Populated dynamically or displays static placeholder -->
                            <div class="aspect-[9/16] bg-zinc-900 border border-zinc-800 rounded-xl flex items-center justify-center text-zinc-600 text-xs">
                                No files
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SCREEN 3: GRADIENTS -->
                <div id="screen-gradients" class="view-transition hidden space-y-4">
                    <div class="flex items-center gap-2 text-gold-400 font-semibold text-sm mb-2">
                        <i data-lucide="palette" class="w-4 h-4"></i>
                        <span>Modern Blends & Gradients</span>
                    </div>
                    <div class="grid grid-cols-3 gap-3" id="gradients-grid">
                        <!-- Dynamic list from JS -->
                    </div>
                </div>

                <!-- SCREEN 4: ABSTRACT -->
                <div id="screen-abstract" class="view-transition hidden space-y-4">
                    <div class="flex items-center gap-2 text-gold-400 font-semibold text-sm mb-2">
                        <i data-lucide="layers" class="w-4 h-4"></i>
                        <span>Abstract Masterpieces</span>
                    </div>
                    <div class="grid grid-cols-3 gap-3" id="abstract-grid">
                        <!-- Dynamic list from JS -->
                    </div>
                </div>

                <!-- SCREEN 5: MINIMAL DARK -->
                <div id="screen-min-dark" class="view-transition hidden space-y-4">
                    <div class="flex items-center gap-2 text-gold-400 font-semibold text-sm mb-2">
                        <i data-lucide="moon" class="w-4 h-4"></i>
                        <span>OLED Minimalist Black & Golds</span>
                    </div>
                    <div class="grid grid-cols-3 gap-3" id="min-dark-grid">
                        <!-- Dynamic list from JS -->
                    </div>
                </div>

                <!-- SCREEN 6: MINIMAL LIGHT -->
                <div id="screen-min-light" class="view-transition hidden space-y-4">
                    <div class="flex items-center gap-2 text-gold-400 font-semibold text-sm mb-2">
                        <i data-lucide="sun" class="w-4 h-4"></i>
                        <span>Bright, Crisp & Modern Minimalism</span>
                    </div>
                    <div class="grid grid-cols-3 gap-3" id="min-light-grid">
                        <!-- Dynamic list from JS -->
                    </div>
                </div>

                <!-- SCREEN 7: SOLIDS -->
                <div id="screen-solids" class="view-transition hidden space-y-4">
                    <div class="flex items-center gap-2 text-gold-400 font-semibold text-sm mb-2">
                        <i data-lucide="spray-can" class="w-4 h-4"></i>
                        <span>Pure Accent Solids</span>
                    </div>
                    <div class="grid grid-cols-3 gap-3" id="solids-grid">
                        <!-- Dynamic list from JS -->
                    </div>
                </div>

            </div>

            <!-- Left Panel Footer (Wallpaper Adjustment Toolbelt) -->
            <div class="p-5 border-t border-white/5 bg-zinc-950/90 backdrop-blur-md space-y-4 z-20">
                <div class="space-y-3">
                    <div class="flex items-center justify-between">
                        <span class="text-xs text-zinc-400 font-medium flex items-center gap-2">
                            <i data-lucide="sliders" class="w-3.5 h-3.5 text-gold-400"></i> Blur Level
                        </span>
                        <span id="blur-val" class="text-xs text-gold-400 font-mono">0px</span>
                    </div>
                    <input id="blur-slider" type="range" min="0" max="25" value="0" class="w-full accent-gold-500 h-1 bg-zinc-800 rounded-lg cursor-pointer">
                </div>

                <div class="space-y-3">
                    <div class="flex items-center justify-between">
                        <span class="text-xs text-zinc-400 font-medium flex items-center gap-2">
                            <i data-lucide="sun" class="w-3.5 h-3.5 text-gold-400"></i> Ambient Overlay Dim
                        </span>
                        <span id="overlay-val" class="text-xs text-gold-400 font-mono">20%</span>
                    </div>
                    <input id="overlay-slider" type="range" min="0" max="90" value="20" class="w-full accent-gold-500 h-1 bg-zinc-800 rounded-lg cursor-pointer">
                </div>

                <!-- Live Info bar displaying extracted color stats -->
                <div class="flex items-center justify-between p-2.5 rounded-xl bg-white/[0.02] border border-white/5 text-[11px] text-zinc-400">
                    <div class="flex items-center gap-2">
                        <div id="indicator-bubble" class="w-3 h-3 rounded-full bg-gold-500 shadow-sm shadow-gold-500/50"></div>
                        <span>Theme Sync Accent:</span>
                        <span id="extracted-accent-text" class="font-mono text-gold-300">#D9A71E</span>
                    </div>
                    <div class="flex items-center gap-1.5 bg-black/40 px-2 py-0.5 rounded-md border border-white/5">
                        <i data-lucide="activity" class="w-3 h-3 text-emerald-400"></i>
                        <span id="extracted-tone" class="text-[10px] text-zinc-300 font-bold uppercase">Dark Theme</span>
                    </div>
                </div>

                <!-- Apply Button -->
                <button id="set-wallpaper-btn" class="w-full py-3.5 rounded-xl bg-gradient-to-r from-gold-600 to-gold-400 text-black font-semibold text-sm shadow-lg shadow-gold-500/15 hover:shadow-gold-500/25 transition-all flex items-center justify-center gap-2 border border-gold-200/20 active:scale-[0.98]">
                    <i data-lucide="check" class="w-4 h-4 stroke-[3]"></i>
                    Set Active Wallpaper
                </button>
            </div>

        </div>

        <!-- ================== RIGHT PANEL: Live Interactive Chat Preview ================== -->
        <div class="w-full md:w-[40%] h-[500px] md:h-full flex flex-col relative bg-zinc-950 overflow-hidden">
            
            <!-- Live Preview Indicator Header -->
            <div class="absolute top-4 left-4 z-20 flex items-center gap-2 bg-black/75 backdrop-blur-md px-3  py-1.5 rounded-full border border-white/10 text-[11px]">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
                <span class="text-zinc-200 font-medium">Interactive Preview</span>
            </div>

            <!-- Preview Top Info bar (Simulating the user header of the chat app) -->
            <div class="px-5 py-4 pt-14 md:pt-4 bg-black/85 backdrop-blur-md border-b border-white/5 flex items-center justify-between z-10">
                <div class="flex items-center gap-3">
                    <div class="relative">
                        <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-gold-600 to-amber-200 p-[1.5px] shadow-md shadow-gold-500/20">
                            <div class="w-full h-full rounded-full bg-zinc-900 flex items-center justify-center overflow-hidden">
                                <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=100&q=80" alt="Avatar" class="w-full h-full object-cover">
                            </div>
                        </div>
                        <div class="absolute bottom-0 right-0 w-3 h-3 bg-emerald-500 border-2 border-black rounded-full"></div>
                    </div>
                    <div>
                        <div class="flex items-center gap-1.5">
                            <h4 class="text-xs font-bold text-white tracking-wide">Isabella Vance</h4>
                            <span class="text-[9px] px-1.5 py-0.2 bg-gold-500/15 text-gold-400 font-bold rounded">VIP</span>
                        </div>
                        <p class="text-[10px] text-emerald-400 font-medium flex items-center gap-1">
                            <span>online</span>
                        </p>
                    </div>
                </div>

                <div class="flex items-center gap-3 text-zinc-400">
                    <button class="hover:text-gold-400 transition-colors"><i data-lucide="phone" class="w-4 h-4"></i></button>
                    <button class="hover:text-gold-400 transition-colors"><i data-lucide="video" class="w-4 h-4"></i></button>
                    <button class="hover:text-gold-400 transition-colors"><i data-lucide="more-vertical" class="w-4 h-4"></i></button>
                </div>
            </div>

            <!-- THE CHAT WALLPAPER DISPLAY CONTAINER -->
            <div id="live-chat-display" class="flex-1 relative overflow-hidden flex flex-col justify-end p-5 transition-all duration-300 bg-center bg-cover">
                
                <!-- Dynamic Blur & Dark Tint Overlays -->
                <div id="preview-blur-overlay" class="absolute inset-0 pointer-events-none transition-all duration-200"></div>
                <div id="preview-tint-overlay" class="absolute inset-0 bg-black/20 pointer-events-none transition-all duration-200"></div>

                <!-- Chat bubble stack -->
                <div class="relative z-10 space-y-4 w-full flex flex-col justify-end overflow-y-auto mb-2 pr-1 max-h-[80%]">
                    
                    <!-- Date pill -->
                    <div class="flex justify-center my-2">
                        <span class="text-[10px] uppercase font-bold tracking-wider px-3 py-1 rounded-full bg-black/60 backdrop-blur-md border border-white/5 text-zinc-400">
                            Today
                        </span>
                    </div>

                    <!-- Left Received Message -->
                    <div class="flex items-start gap-2.5 max-w-[85%] self-start animate-[fadeIn_0.3s_ease]">
                        <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=100&q=80" alt="" class="w-7 h-7 rounded-full object-cover mt-0.5 border border-white/10">
                        <div class="space-y-1">
                            <div class="p-3.5 rounded-2xl rounded-tl-none bg-zinc-900/90 backdrop-blur-md border border-white/5 text-zinc-200 text-xs leading-relaxed shadow-lg">
                                Hey there! Have you tested the new dark gold theme customization panel yet? The dynamic color extracted bubbles look gorgeous. ✨
                            </div>
                            <p class="text-[9px] text-zinc-400/80 pl-1">11:24 AM</p>
                        </div>
                    </div>

                    <!-- Right Sent Message (Active styling synced dynamically) -->
                    <div class="flex flex-col items-end gap-1 max-w-[85%] self-end animate-[fadeIn_0.3s_ease]">
                        <!-- Dynamic active bubble theme applied here -->
                        <div id="active-sent-bubble" class="p-3.5 rounded-2xl rounded-tr-none text-zinc-950 text-xs leading-relaxed shadow-lg font-medium transition-all duration-300">
                            Oh wow, look at this! This chat bubble automatically synchronizes its contrast, color tones, and hue according to the selected wallpaper. Try changing it! 🚀
                        </div>
                        <div class="flex items-center gap-1 text-[9px] text-zinc-400/80 pr-1">
                            <span>11:25 AM</span>
                            <i data-lucide="check-check" class="w-3 h-3 text-emerald-400"></i>
                        </div>
                    </div>

                    <!-- Left Received Message -->
                    <div class="flex items-start gap-2.5 max-w-[85%] self-start animate-[fadeIn_0.3s_ease]">
                        <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=100&q=80" alt="" class="w-7 h-7 rounded-full object-cover mt-0.5 border border-white/10">
                        <div class="space-y-1">
                            <div class="p-3.5 rounded-2xl rounded-tl-none bg-zinc-900/90 backdrop-blur-md border border-white/5 text-zinc-200 text-xs leading-relaxed shadow-lg">
                                Absolutely insane! The dynamic tone indicator even classified the image as dark or bright automatically. 
                            </div>
                            <p class="text-[9px] text-zinc-400/80 pl-1">11:26 AM</p>
                        </div>
                    </div>

                </div>

            </div>

            <!-- Preview Bottom Chat Input Field -->
            <div class="p-4 bg-black/85 backdrop-blur-md border-t border-white/5 z-10">
                <div class="flex items-center gap-2.5 bg-zinc-900/90 border border-white/5 rounded-full px-4 py-2">
                    <button class="text-zinc-400 hover:text-gold-400 transition-colors">
                        <i data-lucide="plus-circle" class="w-5 h-5"></i>
                    </button>
                    <!-- Input color tinting automatically matches selected wallpaper theme -->
                    <input type="text" id="dummy-chat-input" placeholder="Type a professional message..." readonly class="w-full bg-transparent text-xs text-zinc-300 outline-none placeholder-zinc-500 cursor-not-allowed">
                    <div class="flex items-center gap-2">
                        <button class="text-zinc-400 hover:text-gold-400 transition-colors">
                            <i data-lucide="smile" class="w-5 h-5"></i>
                        </button>
                        <!-- Send Button changes color according to theme -->
                        <button id="dummy-send-btn" class="w-8 h-8 rounded-full flex items-center justify-center text-zinc-950 transition-colors">
                            <i data-lucide="send" class="w-4 h-4"></i>
                        </button>
                    </div>
                </div>
            </div>

        </div>

    </div>

    <!-- ================== PREMIUM SUCCESS MODAL ================== -->
    <div id="success-modal" class="fixed inset-0 bg-black/70 backdrop-blur-md z-50 flex items-center justify-center opacity-0 pointer-events-none transition-all duration-300 p-4">
        <div class="glass-panel max-w-sm w-full p-6 rounded-2xl text-center border border-gold-500/30 shadow-2xl transform scale-95 transition-transform duration-300" id="success-modal-card">
            <div class="w-16 h-16 bg-gradient-to-br from-gold-500 to-amber-200 rounded-full flex items-center justify-center mx-auto mb-4 shadow-lg shadow-gold-500/25">
                <i data-lucide="party-popper" class="w-8 h-8 text-black"></i>
            </div>
            <h3 class="text-xl font-bold text-white mb-2">Wallpaper Deployed</h3>
            <p class="text-xs text-zinc-400 mb-5 leading-relaxed">
                Your luxury chat window environment has been configured. Accent colors, contrast safeguards, and overlay levels are synced.
            </p>
            <div class="p-3 bg-white/[0.03] border border-white/5 rounded-xl text-left space-y-1 mb-6">
                <div class="flex justify-between text-[11px]"><span class="text-zinc-500">Theme Sync Color:</span><span id="modal-color" class="font-bold font-mono text-gold-400">#D9A71E</span></div>
                <div class="flex justify-between text-[11px]"><span class="text-zinc-500">System Mode:</span><span id="modal-mode" class="font-bold text-zinc-300 uppercase">Dark Ambient</span></div>
                <div class="flex justify-between text-[11px]"><span class="text-zinc-500">Blur Overlay:</span><span id="modal-blur" class="font-bold text-zinc-300">0px</span></div>
            </div>
            <button onclick="closeSuccessModal()" class="w-full py-3 bg-gradient-to-r from-gold-500 to-gold-400 text-black font-semibold rounded-xl text-xs hover:shadow-lg hover:shadow-gold-500/15 transition-all">
                Dismiss Studio
            </button>
        </div>
    </div>

    <!-- Background CSS effects for fade ins -->
    <style>
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>

    <!-- ================== JAVASCRIPT & APP LOGIC ================== -->
    <script>
        // High quality premium wallpapers database
        const wallpaperDatabase = {
            gradients: [
                { id: 'g1', name: 'Golden Velvet', url: 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=800&q=80', defaultAccent: '#D9A71E' },
                { id: 'g2', name: 'Dark Nebula', url: 'https://images.unsplash.com/photo-1506318137071-a8e063b4bec0?auto=format&fit=crop&w=800&q=80', defaultAccent: '#A78BFA' },
                { id: 'g3', name: 'Warm Amber Blend', url: 'https://images.unsplash.com/photo-1604871000636-074fa5117945?auto=format&fit=crop&w=800&q=80', defaultAccent: '#F59E0B' },
                { id: 'g4', name: 'Deep Ultraviolet', url: 'https://images.unsplash.com/photo-1579783900882-c0d3dad7b119?auto=format&fit=crop&w=800&q=80', defaultAccent: '#EC4899' },
                { id: 'g5', name: 'Sage & Olive', url: 'https://images.unsplash.com/photo-1557683316-973673baf926?auto=format&fit=crop&w=800&q=80', defaultAccent: '#10B981' },
                { id: 'g6', name: 'Holographic Liquid', url: 'https://images.unsplash.com/photo-1536924940846-227afb31e2a5?auto=format&fit=crop&w=800&q=80', defaultAccent: '#06B6D4' }
            ],
            abstract: [
                { id: 'a1', name: 'Liquid Gold Dust', url: 'https://images.unsplash.com/photo-1541701494587-cb58502866ab?auto=format&fit=crop&w=800&q=80', defaultAccent: '#EAB308' },
                { id: 'a2', name: 'Midnight Waves', url: 'https://images.unsplash.com/photo-1508739773434-c26b3d09e071?auto=format&fit=crop&w=800&q=80', defaultAccent: '#3B82F6' },
                { id: 'a3', name: 'Volcanic Shards', url: 'https://images.unsplash.com/photo-1549490349-8643362247b5?auto=format&fit=crop&w=800&q=80', defaultAccent: '#EF4444' },
                { id: 'a4', name: 'Ethereal Quartz', url: 'https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=800&q=80', defaultAccent: '#A78BFA' },
                { id: 'a5', name: 'Abstract Emerald', url: 'https://images.unsplash.com/photo-1550684848-fac1c5b4e853?auto=format&fit=crop&w=800&q=80', defaultAccent: '#10B981' },
                { id: 'a6', name: 'Sands of Mars', url: 'https://images.unsplash.com/photo-1618005198143-e52834644027?auto=format&fit=crop&w=800&q=80', defaultAccent: '#F97316' }
            ],
            minDark: [
                { id: 'md1', name: 'Pure Carbon Fiber', url: 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=800&q=80', defaultAccent: '#808080' },
                { id: 'md2', name: 'Sleek Obsidian', url: 'https://images.unsplash.com/photo-1514343381853-5b65a854d122?auto=format&fit=crop&w=800&q=80', defaultAccent: '#D9A71E' },
                { id: 'md3', name: 'Nordic Night', url: 'https://images.unsplash.com/photo-1502481851512-e9e2529bbbf9?auto=format&fit=crop&w=800&q=80', defaultAccent: '#38BDF8' },
                { id: 'md4', name: 'Abstract Charcoal', url: 'https://images.unsplash.com/photo-1544377193-33dcf4d68fb5?auto=format&fit=crop&w=800&q=80', defaultAccent: '#F3F4F6' },
                { id: 'md5', name: 'Gold Linear', url: 'https://images.unsplash.com/photo-1528459801416-a9e53bbf4e17?auto=format&fit=crop&w=800&q=80', defaultAccent: '#C5A059' },
                { id: 'md6', name: 'Dark Grid', url: 'https://images.unsplash.com/photo-1557682250-33bd709cbe85?auto=format&fit=crop&w=800&q=80', defaultAccent: '#D9A71E' }
            ],
            minLight: [
                { id: 'ml1', name: 'Crisp Alabaster', url: 'https://images.unsplash.com/photo-1513542789411-b6a5d4f31634?auto=format&fit=crop&w=800&q=80', defaultAccent: '#B45309' },
                { id: 'ml2', name: 'Soft Chalk Grid', url: 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=800&q=80', defaultAccent: '#2563EB' },
                { id: 'ml3', name: 'Minimalist Ivory', url: 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=800&q=80', defaultAccent: '#059669' },
                { id: 'ml4', name: 'Warm Cream Waves', url: 'https://images.unsplash.com/photo-1541701494587-cb58502866ab?auto=format&fit=crop&w=800&q=80', defaultAccent: '#7C3AED' }
            ],
            solids: [
                { id: 's1', name: 'Premium Jet Black', url: 'solid_#09090B', defaultAccent: '#D9A71E' },
                { id: 's2', name: 'Rich Desert Tan', url: 'solid_#C5A059', defaultAccent: '#27272A' },
                { id: 's3', name: 'Royal Velvet Plum', url: 'solid_#2E1065', defaultAccent: '#F472B6' },
                { id: 's4', name: 'Forest Emerald', url: 'solid_#064E3B', defaultAccent: '#34D399' },
                { id: 's5', name: 'Classic Slate', url: 'solid_#1F2937', defaultAccent: '#38BDF8' },
                { id: 's6', name: 'Onyx Dark', url: 'solid_#18181B', defaultAccent: '#F59E0B' }
            ]
        };

        // App state
        let currentScreen = 'screen-main';
        const navigationHistory = ['screen-main']; // Back-button Stack Navigation
        let selectedWallpaperUrl = '';
        let extractedAccentColor = '#D9A71E';
        let extractedIsDark = true;
        let recentCustomUploadsList = [];

        // Elements Cache
        const screensContainer = document.getElementById('screens-container');
        const liveChatDisplay = document.getElementById('live-chat-display');
        const activeSentBubble = document.getElementById('active-sent-bubble');
        const extractedAccentText = document.getElementById('extracted-accent-text');
        const extractedTone = document.getElementById('extracted-tone');
        const indicatorBubble = document.getElementById('indicator-bubble');
        const dummySendBtn = document.getElementById('dummy-send-btn');
        
        // Custom sliders
        const blurSlider = document.getElementById('blur-slider');
        const blurVal = document.getElementById('blur-val');
        const previewBlurOverlay = document.getElementById('preview-blur-overlay');

        const overlaySlider = document.getElementById('overlay-slider');
        const overlayVal = document.getElementById('overlay-val');
        const previewTintOverlay = document.getElementById('preview-tint-overlay');

        // Toggle properties
        const themeSyncToggle = document.getElementById('theme-sync-toggle');
        const contrastGuardToggle = document.getElementById('contrast-guard-toggle');

        // Back button UI controller
        const navBackBtn = document.getElementById('nav-back-btn');

        // Initialize the Web App
        window.onload = function() {
            // Lucide icon replacement init
            lucide.createIcons();

            // Setup Custom State Navigation
            window.history.replaceState({ screen: 'screen-main' }, 'Wallpaper Studio Home', '');
            
            // Generate grids for options
            renderGrids();

            // Set default wallpaper on launch (first of gradient option)
            selectWallpaper(wallpaperDatabase.gradients[0].url, wallpaperDatabase.gradients[0].defaultAccent);

            // Bind Event Listeners
            setupEventListeners();
        };

        // Screen Navigation engine with Stack history to handle both UI and hardware back clicks
        function navigateTo(screenId) {
            if (currentScreen === screenId) return;

            // Hide the active screen element
            const activeElem = document.getElementById(currentScreen);
            if (activeElem) {
                activeElem.classList.add('hidden');
            }

            // Show target screen
            const targetElem = document.getElementById(screenId);
            if (targetElem) {
                targetElem.classList.remove('hidden');
                targetElem.classList.add('animate-[fadeIn_0.2s_ease]');
            }

            // Update local state
            currentScreen = screenId;
            navigationHistory.push(screenId);

            // Update browser state to capture Android / iOS/ Hardware / Back clicks!
            window.history.pushState({ screen: screenId }, `Screen - ${screenId}`, `#${screenId}`);

            // Toggle back button visibility
            toggleBackButton();
        }

        // Logic executed when backing out of screens
        function goBack() {
            if (navigationHistory.length <= 1) return;

            // Remove current screen from stack
            const current = navigationHistory.pop();
            const previous = navigationHistory[navigationHistory.length - 1];

            // Toggle screen elements visibility
            const currentElem = document.getElementById(current);
            if (currentElem) {
                currentElem.classList.add('hidden');
            }

            const prevElem = document.getElementById(previous);
            if (prevElem) {
                prevElem.classList.remove('hidden');
                prevElem.classList.add('animate-[fadeIn_0.2s_ease]');
            }

            currentScreen = previous;
            toggleBackButton();
        }

        // Handle physical/browser device back clicks via History API State Events
        window.onpopstate = function(event) {
            if (event.state && event.state.screen) {
                const targetScreen = event.state.screen;
                
                // Track back alignment
                if (currentScreen !== targetScreen) {
                    const currentElem = document.getElementById(currentScreen);
                    if (currentElem) currentElem.classList.add('hidden');
                    
                    const targetElem = document.getElementById(targetScreen);
                    if (targetElem) {
                        targetElem.classList.remove('hidden');
                        targetElem.classList.add('animate-[fadeIn_0.2s_ease]');
                    }
                    
                    // Synchronize stack tracker
                    currentScreen = targetScreen;
                    const index = navigationHistory.indexOf(targetScreen);
                    if (index !== -1) {
                        navigationHistory.length = index + 1;
                    } else {
                        navigationHistory.push(targetScreen);
                    }
                    
                    toggleBackButton();
                }
            }
        };

        function toggleBackButton() {
            if (currentScreen === 'screen-main') {
                navBackBtn.classList.add('hidden');
            } else {
                navBackBtn.classList.remove('hidden');
            }
        }

        // Render high-fidelity design categories inside preview panels
        function renderGrids() {
            // Render Gradients
            populateWallpaperGrid('gradients-grid', wallpaperDatabase.gradients);
            // Render Abstracts
            populateWallpaperGrid('abstract-grid', wallpaperDatabase.abstract);
            // Render Min Dark
            populateWallpaperGrid('min-dark-grid', wallpaperDatabase.minDark);
            // Render Min Light
            populateWallpaperGrid('min-light-grid', wallpaperDatabase.minLight);
            // Render Solids
            populateWallpaperGrid('solids-grid', wallpaperDatabase.solids, true);
        }

        function populateWallpaperGrid(containerId, items, isSolid = false) {
            const container = document.getElementById(containerId);
            if (!container) return;

            container.innerHTML = '';
            items.forEach(item => {
                const card = document.createElement('div');
                card.className = 'relative aspect-[9/14] rounded-xl overflow-hidden cursor-pointer border border-white/5 hover:border-gold-500/50 transition-all group flex flex-col justify-end p-2 bg-zinc-900';
                
                if (isSolid) {
                    const colorHex = item.url.split('_')[1];
                    card.style.backgroundColor = colorHex;
                } else {
                    card.style.backgroundImage = `url('${item.url}')`;
                    card.style.backgroundSize = 'cover';
                    card.style.backgroundPosition = 'center';
                }

                // Hover accent overlay
                const overlay = document.createElement('div');
                overlay.className = 'absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center';
                overlay.innerHTML = `<span class="text-[10px] text-gold-400 font-bold uppercase tracking-wider bg-black/70 px-2.5 py-1 rounded-full border border-gold-500/30">Preview</span>`;
                card.appendChild(overlay);

                // Label
                const label = document.createElement('div');
                label.className = 'absolute bottom-1.5 left-1.5 right-1.5 bg-black/75 backdrop-blur-md py-1 px-2 rounded-lg border border-white/5 text-[9px] text-zinc-300 font-medium flex items-center justify-between pointer-events-none truncate';
                label.innerHTML = `<span>${item.name}</span> <i data-lucide="eye" class="w-2.5 h-2.5 text-gold-400"></i>`;
                card.appendChild(label);

                // On selection
                card.onclick = () => {
                    selectWallpaper(item.url, item.defaultAccent);
                };

                container.appendChild(card);
            });
            // Re-render new lucide icons inside dynamically populated cards
            lucide.createIcons();
        }

        // Setup Wallpaper and dynamic theme color generation
        function selectWallpaper(url, fallbackAccent) {
            selectedWallpaperUrl = url;

            // Apply to live chat preview container
            if (url.startsWith('solid_')) {
                const hexColor = url.split('_')[1];
                liveChatDisplay.style.backgroundImage = 'none';
                liveChatDisplay.style.backgroundColor = hexColor;
                
                // Set solid dark or light status directly
                const isLight = isLightColor(hexColor);
                applyExtractedTheme(hexColor, !isLight);
            } else {
                liveChatDisplay.style.backgroundColor = 'transparent';
                liveChatDisplay.style.backgroundImage = `url('${url}')`;

                // If theme sync toggle is on, try to analyze the image colors
                if (themeSyncToggle.checked) {
                    extractColorsFromImage(url, fallbackAccent);
                } else {
                    applyExtractedTheme(fallbackAccent, true);
                }
            }

            // Visual feedback - highlight selected thumbnail border if present (could be added for ultimate polish)
        }

        // Color Analytics Algorithm: Extracts dominant accent color & tone brightness from a source image
        function extractColorsFromImage(imageUrl, fallbackColor) {
            const img = new Image();
            img.crossOrigin = 'Anonymous';
            img.onload = function() {
                try {
                    const canvas = document.getElementById('extraction-canvas');
                    const ctx = canvas.getContext('2d');
                    
                    // Downscale the image on a small canvas to average out dominant pixels
                    canvas.width = 30;
                    canvas.height = 30;
                    ctx.drawImage(img, 0, 0, 30, 30);
                    
                    const imgData = ctx.getImageData(0, 0, 30, 30).data;
                    
                    let rAvg = 0, gAvg = 0, bAvg = 0;
                    let count = 0;

                    // Samples pixels and average RGB values
                    for (let i = 0; i < imgData.length; i += 4) {
                        rAvg += imgData[i];
                        gAvg += imgData[i + 1];
                        bAvg += imgData[i + 2];
                        count++;
                    }

                    rAvg = Math.floor(rAvg / count);
                    gAvg = Math.floor(gAvg / count);
                    bAvg = Math.floor(bAvg / count);

                    // Convert to hex
                    let hex = rgbToHex(rAvg, gAvg, bAvg);

                    // Calculate average brightness to decide system theme category
                    const brightness = (rAvg * 299 + gAvg * 587 + bAvg * 114) / 1000;
                    const isDark = brightness < 128;

                    // Ensure extracted color is vibrant and has high visibility context
                    if (contrastGuardToggle.checked) {
                        hex = adjustVibrancy(rAvg, gAvg, bAvg, isDark);
                    }

                    applyExtractedTheme(hex, isDark);
                } catch (e) {
                    console.log('Image extraction restricted or failed (CORS limit/local). Using fallback accent.', e);
                    applyExtractedTheme(fallbackColor, true);
                }
            };
            img.onerror = function() {
                applyExtractedTheme(fallbackColor, true);
            };
            img.src = imageUrl;
        }

        // Helper: Convert RGB channels to Hex string
        function rgbToHex(r, g, b) {
            return "#" + ((1 << 24) + (r << 16) + (g << 8) + b).toString(16).slice(1);
        }

        // Helper: Analyze if solid background is light
        function isLightColor(colorHex) {
            const hex = colorHex.replace('#', '');
            const r = parseInt(hex.substring(0, 2), 16);
            const g = parseInt(hex.substring(2, 4), 16);
            const b = parseInt(hex.substring(4, 6), 16);
            const brightness = (r * 299 + g * 587 + b * 114) / 1000;
            return brightness > 128;
        }

        // Helper: Amplifies saturation and sets custom contrast for premium chat text compatibility
        function adjustVibrancy(r, g, b, isDark) {
            // High visibility correction for dark theme wallpapers vs light theme wallpapers
            if (isDark) {
                // If too dark, bring up luminance slightly for readable text overlay
                const factor = 1.35;
                const newR = Math.min(255, Math.floor(r * factor + 40));
                const newG = Math.min(255, Math.floor(g * factor + 35));
                const newB = Math.min(255, Math.floor(b * factor + 20));
                return rgbToHex(newR, newG, newB);
            } else {
                // For light backdrops, clamp darker tones to ensure text in active bubbles remains super readable
                const factor = 0.75;
                const newR = Math.max(20, Math.floor(r * factor));
                const newG = Math.max(20, Math.floor(g * factor));
                const newB = Math.max(20, Math.floor(b * factor));
                return rgbToHex(newR, newG, newB);
            }
        }

        // Applying custom extracted theme dynamically to elements inside HTML
        function applyExtractedTheme(hexAccent, isDarkTheme) {
            extractedAccentColor = hexAccent;
            extractedIsDark = isDarkTheme;

            // 1. Live Info panel update
            extractedAccentText.textContent = hexAccent;
            indicatorBubble.style.backgroundColor = hexAccent;
            indicatorBubble.style.boxShadow = `0 0 12px ${hexAccent}80`;

            if (isDarkTheme) {
                extractedTone.textContent = "Dark Theme Sync";
                extractedTone.className = "text-[10px] text-zinc-300 font-bold uppercase";
            } else {
                extractedTone.textContent = "Light Theme Sync";
                extractedTone.className = "text-[10px] text-zinc-950 bg-gold-400 font-bold uppercase px-1 rounded";
            }

            // 2. Active chat bubble background customizer
            activeSentBubble.style.backgroundColor = hexAccent;
            
            // Contrast-friendly text color inside bubble based on extracted accent
            const isBubbleLight = isLightColor(hexAccent);
            if (isBubbleLight) {
                activeSentBubble.style.color = '#09090B'; // Premium dark zinc
                dummySendBtn.style.color = '#09090B';
            } else {
                activeSentBubble.style.color = '#FFFFFF';
                dummySendBtn.style.color = '#FFFFFF';
            }

            // 3. Match input send button with the theme accent
            dummySendBtn.style.backgroundColor = hexAccent;
        }

        // Setup DOM event listeners
        function setupEventListeners() {
            // UI Back Click
            navBackBtn.addEventListener('click', goBack);

            // Live Blur Control
            blurSlider.addEventListener('input', function(e) {
                const val = e.target.value;
                blurVal.textContent = `${val}px`;
                previewBlurOverlay.style.backdropFilter = `blur(${val}px)`;
                previewBlurOverlay.style.webkitBackdropFilter = `blur(${val}px)`;
            });

            // Live Overlay Dimming (Brightness Tint)
            overlaySlider.addEventListener('input', function(e) {
                const val = e.target.value;
                overlayVal.textContent = `${val}%`;
                previewTintOverlay.style.backgroundColor = `rgba(0, 0, 0, ${val / 100})`;
            });

            // Toggle Switches
            themeSyncToggle.addEventListener('change', function() {
                selectWallpaper(selectedWallpaperUrl, '#D9A71E');
            });

            contrastGuardToggle.addEventListener('change', function() {
                selectWallpaper(selectedWallpaperUrl, '#D9A71E');
            });

            // Dropzone & File uploader logic
            const fileInput = document.getElementById('file-input');
            const dropzone = document.getElementById('dropzone');

            // Click upload trigger
            fileInput.addEventListener('change', handleFileUploader);

            // Drag and drop events
            ['dragenter', 'dragover'].forEach(eventName => {
                dropzone.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    dropzone.classList.add('border-gold-500', 'bg-gold-500/5');
                }, false);
            });

            ['dragleave', 'drop'].forEach(eventName => {
                dropzone.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    dropzone.classList.remove('border-gold-500', 'bg-gold-500/5');
                }, false);
            });

            dropzone.addEventListener('drop', (e) => {
                const dt = e.dataTransfer;
                const files = dt.files;
                if (files.length) {
                    fileInput.files = files;
                    handleFileUploader();
                }
            });

            // Handle Custom Success deployment action
            document.getElementById('set-wallpaper-btn').addEventListener('click', showSuccessDeployment);
        }

        // File loading to dynamically generate base64 and feed the color extraction engine
        function handleFileUploader() {
            const fileInput = document.getElementById('file-input');
            if (fileInput.files && fileInput.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const customUrl = e.target.result;
                    
                    // Apply to current selection & auto analyze
                    selectWallpaper(customUrl, '#D9A71E');

                    // Store to recent uploads UI
                    addToRecentCustomUploads(customUrl);

                    // Auto navigate user to home so they can view preview changes immediately
                    navigateTo('screen-main');
                }
                reader.readAsDataURL(fileInput.files[0]);
            }
        }

        function addToRecentCustomUploads(base64Url) {
            recentCustomUploadsList.unshift(base64Url);
            if (recentCustomUploadsList.length > 4) {
                recentCustomUploadsList.pop();
            }

            const container = document.getElementById('recent-custom-uploads');
            container.innerHTML = '';

            recentCustomUploadsList.forEach((url, index) => {
                const wrap = document.createElement('div');
                wrap.className = 'aspect-[9/16] rounded-xl overflow-hidden cursor-pointer border border-white/10 hover:border-gold-500 transition-all relative group';
                wrap.style.backgroundImage = `url('${url}')`;
                wrap.style.backgroundSize = 'cover';
                wrap.style.backgroundPosition = 'center';

                wrap.onclick = () => {
                    selectWallpaper(url, '#D9A71E');
                };

                // Badge indicator for uploaded item
                const badge = document.createElement('span');
                badge.className = 'absolute top-1 left-1 bg-gold-500 text-black text-[8px] font-bold px-1.5 py-0.2 rounded';
                badge.innerText = `NEW`;
                wrap.appendChild(badge);

                container.appendChild(wrap);
            });
        }

        // Trigger Success Modal
        function showSuccessDeployment() {
            // Set modal info
            document.getElementById('modal-color').textContent = extractedAccentColor;
            document.getElementById('modal-color').style.color = extractedAccentColor;
            document.getElementById('modal-mode').textContent = extractedIsDark ? "Dark Appearance Sync" : "Light Appearance Sync";
            document.getElementById('modal-blur').textContent = `${blurSlider.value}px`;

            const modal = document.getElementById('success-modal');
            const card = document.getElementById('success-modal-card');
            
            modal.classList.remove('opacity-0', 'pointer-events-none');
            card.classList.remove('scale-95');
            card.classList.add('scale-100');
        }

        function closeSuccessModal() {
            const modal = document.getElementById('success-modal');
            const card = document.getElementById('success-modal-card');
            
            modal.classList.add('opacity-0', 'pointer-events-none');
            card.classList.remove('scale-100');
            card.classList.add('scale-95');
        }
    </script>
</body>
</html>

```
